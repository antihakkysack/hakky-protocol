# ── Hakky services config (copy to .env) ────────────────────────────────
NODE_ENV=development
PORT=8080
OPERATING_MODE=demo
# Docker Compose sets this per container: api | attestation | reserve-oracle | orchestrator
SERVICE_ROLE=api

# EVM chain (Sepolia demo defaults)
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Demo-only shared signer fallback. Live mode ignores this value.
SIGNER_PRIVATE_KEY=
# Dedicated operational signers prevent cross-process nonce races and limit roles.
# For a real pilot, inject these from a secret manager; do not commit them.
ATTESTATION_SIGNER_PRIVATE_KEY=
RESERVE_ORACLE_SIGNER_PRIVATE_KEY=
ORCHESTRATOR_SIGNER_PRIVATE_KEY=

# Deployed contract addresses (fill after: contracts/ -> hardhat deploy --network sepolia)
ADDR_CLEAN_BTC=
ADDR_RESERVE_ORACLE=
ADDR_ATTESTATION_REGISTRY=
ADDR_COMPLIANCE_POLICY=
ADDR_RESERVE_VAULT=

# Postgres (audit log + job state)
DATABASE_URL=postgres://hakky:hakky@localhost:5432/hakky

# Provenance screening. Live mode requires manual-evidence or a future provider adapter.
SCREENING_PROVIDER=stub

# Deposit/custody verification. Live mode requires bitcoin-core + mainnet + >=6 confirmations.
DEPOSIT_VERIFICATION_MODE=stub
BITCOIN_NETWORK=regtest
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_RPC_WALLET=hakky-pilot
BITCOIN_CUSTODY_ADDRESS=
BITCOIN_MIN_CONFIRMATIONS=6
# Operator-funded satoshis held in custody ABOVE user liabilities, to pay
# redemption miner fees. Payouts pay the recipient exactly, so the fee comes out
# of custody while liabilities fall by the payout amount alone; without this
# headroom the first payout drops reserves below liabilities permanently and
# blocks all further minting. Must be > 0 in live mode. Size it for the number of
# payouts expected between top-ups at a comfortable fee rate.
BITCOIN_FEE_BUFFER_SATS=200000

# Reserve oracle. Stub balance is ignored in bitcoin-core mode.
RESERVE_ORACLE_CRON=*/5 * * * *
RESERVE_HEARTBEAT_SECONDS=21600
RESERVE_MAX_STALENESS_SECONDS=43200
CUSTODY_BALANCE_SATS=0            # BTC custody figure in sats; 0 disables publishing
RESERVE_REPORT_URI=https://api.hakky.xyz/reports/reserve-latest.json

# attestation-service (POST /screen)
ATTESTATION_PORT=8081
ATTESTATION_TTL_SECONDS=0         # 0 => contract defaultTtl (90 days)
SANCTIONED_ADDRESSES=            # comma-separated demo sanctions list

# Orchestrator (verified deposit + durable redemption index)
ORCHESTRATOR_PORT=8082
REDEMPTION_MODE=demo-auto
# Live mode requires the ReserveVault deployment block and >=12 EVM confirmations.
REDEMPTION_START_BLOCK=0
REDEMPTION_POLL_MS=15000
EVM_EVENT_CONFIRMATIONS=2
EVM_LOG_BATCH_SIZE=2000
# Demo defaults to 1; live mode requires >=6.
BITCOIN_PAYOUT_MIN_CONFIRMATIONS=1

# Write-endpoint auth. Live mode requires at least 32 random characters.
WRITE_API_KEY=
