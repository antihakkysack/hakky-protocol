# Copy to .env and fill in for testnet/mainnet deploys.
# NEVER commit a real .env — it is gitignored.

# RPC endpoint for the target network (e.g. Alchemy/Infura Sepolia URL)
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=

# Ephemeral funded deployer. Mainnet deployment is separately confirmation-gated.
DEPLOYER_PRIVATE_KEY=

# Mainnet role holders. PROTOCOL_ADMIN_ADDRESS should be a hardware-backed multisig.
PROTOCOL_ADMIN_ADDRESS=
ATTESTOR_ADDRESS=
RESERVE_UPDATER_ADDRESS=
VERIFIER_ADDRESS=
SETTLER_ADDRESS=
PAUSER_ADDRESS=

# Exact phrase required by scripts/deploy.js before it will submit mainnet transactions.
CONFIRM_MAINNET_ONE_BTC_PILOT=

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# Set to "true" to print a gas report when running tests
REPORT_GAS=false
