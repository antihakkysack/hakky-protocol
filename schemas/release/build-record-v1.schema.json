{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakky.xyz/schemas/release/build-record-v1.schema.json",
  "title": "HAKKY candidate SBF build record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lane",
    "buildDirectory",
    "startedAt",
    "completedAt",
    "source",
    "operator",
    "dependencies",
    "release",
    "container",
    "toolchain",
    "invocation",
    "logs",
    "surface",
    "executable",
    "mainnetActionsAuthorized"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hakky-sbf-build-record-v1"
    },
    "lane": {
      "const": "candidate-sbf"
    },
    "buildDirectory": {
      "type": "string",
      "pattern": "^artifacts/build/candidate/[a-z0-9][a-z0-9-]*$"
    },
    "startedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "completedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree",
        "clean",
        "sha256"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/gitObject"
        },
        "tree": {
          "$ref": "#/$defs/gitObject"
        },
        "clean": {
          "const": true
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "organizationId",
        "operatorId",
        "configPath",
        "configSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": "hakky-local-build-operator-v1"
        },
        "organizationId": {
          "const": "hakky-local"
        },
        "operatorId": {
          "const": "local-controller"
        },
        "configPath": {
          "const": "config/local-build-operator-v1.json"
        },
        "configSha256": {
          "const": "bf63bb25f57db74ee1eb01026db9fc607c8d053dbfad493fe1473b125eccf95c"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cargoLockSha256",
        "vendorManifestSha256",
        "vendorTreeSha256",
        "vendorSourceConfigSha256"
      ],
      "properties": {
        "cargoLockSha256": {
          "$ref": "#/$defs/sha256"
        },
        "vendorManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "vendorTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "vendorSourceConfigSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configSha256",
        "rustViewSha256",
        "javascriptViewSha256"
      ],
      "properties": {
        "configSha256": {
          "$ref": "#/$defs/sha256"
        },
        "rustViewSha256": {
          "$ref": "#/$defs/sha256"
        },
        "javascriptViewSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "network"
      ],
      "properties": {
        "image": {
          "const": "solanafoundation/solana-verifiable-build:4.0.0@sha256:0b4e3716fad9ca4b4aac3e3f977f43aad93a18c22296c0c0f44fc22e644bdd68"
        },
        "network": {
          "const": "none"
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rustc",
        "cargo",
        "solana",
        "cargoBuildSbf"
      ],
      "properties": {
        "rustc": {
          "$ref": "#/$defs/toolVersion"
        },
        "cargo": {
          "$ref": "#/$defs/toolVersion"
        },
        "solana": {
          "$ref": "#/$defs/toolVersion"
        },
        "cargoBuildSbf": {
          "$ref": "#/$defs/toolVersion"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "environment"
      ],
      "properties": {
        "command": {
          "const": [
            "cargo-build-sbf",
            "--offline",
            "--skip-tools-install",
            "--tools-version",
            "v1.53",
            "--arch",
            "v0",
            "--",
            "--locked"
          ]
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "CARGO_HOME",
            "RUSTUP_TOOLCHAIN"
          ],
          "properties": {
            "CARGO_HOME": {
              "const": "/cargo-home"
            },
            "RUSTUP_TOOLCHAIN": {
              "const": "1.93.1"
            }
          }
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdoutSha256",
        "stderrSha256"
      ],
      "properties": {
        "stdoutSha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderrSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "releaseProgramId",
        "releaseProgramIdByteOccurrences",
        "testProgramId",
        "testProgramIdByteOccurrences",
        "testProgramIdTextOccurrences",
        "testArtifactPathOccurrences",
        "testArtifactSha256Occurrences"
      ],
      "properties": {
        "method": {
          "const": "raw-executable-byte-scan-v1"
        },
        "releaseProgramId": {
          "const": "Bp5ULfE8tLo7X24kHxWhUmRmWWzD9HdpNa7wxipngfxc"
        },
        "releaseProgramIdByteOccurrences": {
          "type": "integer",
          "minimum": 1
        },
        "testProgramId": {
          "const": "FAe4sisG95oZ42w7buUn5qEE4TAnfTTFPiguZUHmhiF"
        },
        "testProgramIdByteOccurrences": {
          "const": 0
        },
        "testProgramIdTextOccurrences": {
          "const": 0
        },
        "testArtifactPathOccurrences": {
          "const": 0
        },
        "testArtifactSha256Occurrences": {
          "const": 0
        }
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "name": {
          "const": "hakky_market.so"
        },
        "path": {
          "const": "hakky_market.so"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "mainnetActionsAuthorized": {
      "const": false
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n\\u0000]+$"
    }
  }
}
