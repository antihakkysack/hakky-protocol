{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakky.xyz/schemas/release/image-ipfs-v1.schema.json",
  "title": "HAKKY approved image two-gateway IPFS receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cid",
    "source",
    "gateways",
    "verifiedAt",
    "mainnetActionsAuthorized"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hakky-image-ipfs-v1"
    },
    "cid": {
      "const": "bafkreie6m4wnyrkomjeyopg7gwnvdipy62t7riipav6xp6c6zttqlpfiua"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "web/assets/token.png"
        },
        "byteLength": {
          "const": 74230
        },
        "sha256": {
          "const": "9e672cdc454e6249873cdf359b51a1f8f6a7f8a10f057d77f85ecce705bca8a0"
        }
      }
    },
    "gateways": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/ipfsIo"
        },
        {
          "$ref": "#/$defs/dwebLink"
        }
      ],
      "items": false
    },
    "verifiedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "mainnetActionsAuthorized": {
      "const": false
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "gatewayBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "resolvedUrl",
        "contentType",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "resolvedUrl": {
          "type": "string"
        },
        "contentType": {
          "const": "image/png"
        },
        "byteLength": {
          "const": 74230
        },
        "sha256": {
          "const": "9e672cdc454e6249873cdf359b51a1f8f6a7f8a10f057d77f85ecce705bca8a0"
        }
      }
    },
    "ipfsIo": {
      "allOf": [
        {
          "$ref": "#/$defs/gatewayBase"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "ipfs-io"
            },
            "url": {
              "const": "https://ipfs.io/ipfs/bafkreie6m4wnyrkomjeyopg7gwnvdipy62t7riipav6xp6c6zttqlpfiua"
            },
            "resolvedUrl": {
              "const": "https://ipfs.io/ipfs/bafkreie6m4wnyrkomjeyopg7gwnvdipy62t7riipav6xp6c6zttqlpfiua"
            }
          }
        }
      ]
    },
    "dwebLink": {
      "allOf": [
        {
          "$ref": "#/$defs/gatewayBase"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "dweb-link"
            },
            "url": {
              "const": "https://dweb.link/ipfs/bafkreie6m4wnyrkomjeyopg7gwnvdipy62t7riipav6xp6c6zttqlpfiua"
            },
            "resolvedUrl": {
              "enum": [
                "https://dweb.link/ipfs/bafkreie6m4wnyrkomjeyopg7gwnvdipy62t7riipav6xp6c6zttqlpfiua",
                "https://bafkreie6m4wnyrkomjeyopg7gwnvdipy62t7riipav6xp6c6zttqlpfiua.ipfs.dweb.link/"
              ]
            }
          }
        }
      ]
    }
  }
}
