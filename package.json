{
  "name": "hakky-protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HAKKY is a personal, transparent Solana fair-launch meme coin whose launch facts are checked by HakkyAgent.",
  "homepage": "https://hakky.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/antihakkysack/hakky-protocol.git"
  },
  "license": "MIT",
  "scripts": {
    "assets": "node scripts/render-assets.mjs",
    "build:curve-live-record": "node scripts/build-curve-live-record.mjs",
    "build:unavailable-record": "node scripts/build-unavailable-record.mjs",
    "check": "npm run test && npm run check:repo && npm run check:site",
    "check:repo": "node scripts/check-repo.mjs",
    "check:site": "node scripts/check-site.mjs",
    "metadata:finalize": "node scripts/finalize-metadata-manifest.mjs",
    "metadata:prepare": "node scripts/prepare-metadata.mjs",
    "metadata:verify": "node scripts/verify-metadata-upload.mjs",
    "preview": "serve web",
    "rehearsal:devnet": "node scripts/rehearse-devnet.mjs",
    "schemas": "node scripts/render-launch-schema-validator.mjs",
    "session:receipt": "node scripts/session-receipt.mjs",
    "test": "node --test",
    "verify:launchlab": "node scripts/verify-launchlab.mjs",
    "verify:launch-preview": "node scripts/verify-launchlab-preview.mjs",
    "verify:raydium-origin": "node scripts/verify-raydium-origin.mjs",
    "verify:graduation": "node scripts/verify-graduation.mjs",
    "verify:wallet-readiness": "node scripts/verify-wallet-readiness.mjs",
    "verify:token": "node scripts/verify-token.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "ajv": "8.20.0",
    "entities": "8.0.0"
  },
  "devDependencies": {
    "serve": "14.2.6",
    "sharp": "0.35.3"
  }
}
